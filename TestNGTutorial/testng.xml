<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Loan Department" parallel="tests" thread-count="5">

	<listeners>
		<listener class-name="TestNG.Listeners"></listener>
	</listeners>
	<parameter name="URL" value="www.google.com"></parameter>
	<test thread-count="5" name="Personal Loan">
		<classes>
			<class name="TestNG.demo" />
			<class name="TestNG.demo2" />
		</classes>
	</test> <!-- Test -->

	<test thread-count="5" name="Car Loan">
		<classes>
			<class name="TestNG.demo3">
				<methods>
					<!--	<exclude name="Mobile.*"></exclude>-->
					<!--<include name="Mobile.*"></include>-->
					<exclude name="API.*"></exclude>
				</methods>
			</class>
		</classes>
	</test> <!--Test -->


	<test thread-count="5" name="Home Loan">
		<classes>
			<class name="TestNG.demo4">
				<methods>
					<include name="LoignHomeAPI"></include>
				</methods>
			</class>
		</classes>
	</test> <!--
	Test -->

</suite> <!--
Suite -->
